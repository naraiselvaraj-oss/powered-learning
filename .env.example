# Required for Gemini-backed features
GEMINI_API_KEY=your_google_ai_studio_api_key

# Current default is a stable Gemini model. You can change it if your account
# has access to another model.
GEMINI_MODEL=gemini-2.5-flash

# The project documentation specifies LaMini-Flan-T5 for local explanations.
# Keep false for a lightweight first run. Set true after installing
# requirements-local.txt.
ENABLE_LOCAL_EXPLANATION=false
LOCAL_EXPLANATION_MODEL=MBZUAI/LaMini-Flan-T5-783M

MAX_INPUT_CHARS=20000
